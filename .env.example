# =================================================================
# Mighty Morphing — NatSec Hackathon (May 2-3, 2026)
# =================================================================
# Copy to .env and fill in. Never commit .env.

# --- Mighty Citadel (consumed as a hosted AI security API) ---------
CITADEL_API_KEY=
CITADEL_GATEWAY_URL=https://your-citadel-gateway.example
CITADEL_AUDIO_URL=https://your-citadel-audio.example
CITADEL_AUDIO_WS_URL=wss://your-citadel-audio.example
CITADEL_VISION_URL=

# --- Palantir Foundry / AIP ----------------------------------------
FOUNDRY_STACK_URL=https://nshackathon.palantirfoundry.com
FOUNDRY_TOKEN=
FOUNDRY_ONTOLOGY_RID=

# --- Voice fixture providers (for synthesizing demo attacks) -------
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# --- Server config -------------------------------------------------
MM_BACKEND_PORT=7001  # 7001 by default — port 7000 collides with macOS AirPlay Receiver
MM_WEB_DEV_PORT=5173
MM_LOG_LEVEL=info
MM_DATA_DIR=../data
MM_SECRETS_DIR=../.secrets

# --- Voice biometric sidecar (Python, SpeechBrain ECAPA-TDNN) ------
VOICEBIO_URL=http://localhost:7100
VOICEBIO_MODEL_CACHE=/tmp/speechbrain-cache

# --- Detection thresholds (tuneable in dry runs) -------------------
MM_SPEAKER_MATCH_THRESHOLD=0.59   # measured p05 real holdout floor from Phase 0; OOB carries clone defense
MM_DEEPFAKE_BLOCK_THRESHOLD=80    # Citadel deepfake risk above this -> BLOCK
MM_INJECTION_BLOCK_THRESHOLD=70   # Citadel injection risk above this -> BLOCK
MM_AUTH_LATENCY_BUDGET_MS=500     # soft target; logged for SLA tracking
MM_OOB_TIMEOUT_MS=5000            # phone approval timeout; fail closed
